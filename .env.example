# Copy to .env and replace the placeholder with a random hex string.
POSTGRES_PASSWORD=
SHIPPING_WEB_PORT=3000
SHIPPING_API_PORT=8001
SHIPPING_WEB_ORIGIN=http://localhost:3000
SHIPPING_INVESTIGATION_ENABLED=true
SHIPPING_OLLAMA_ENABLED=false
SHIPPING_OLLAMA_URL=http://host.docker.internal:11434
SHIPPING_OLLAMA_MODEL=qwen3.5:4b-q4_K_M
SHIPPING_OLLAMA_CONTEXT=4096
SHIPPING_OLLAMA_MAX_CONCURRENCY=1

# Optional provider configuration. Never commit live credentials.
SHIPPING_GMAIL_CLIENT_ID=
SHIPPING_GMAIL_CLIENT_SECRET=
SHIPPING_CONNECTOR_KEY=
SHIPPING_TELEGRAM_BOT_TOKEN=
